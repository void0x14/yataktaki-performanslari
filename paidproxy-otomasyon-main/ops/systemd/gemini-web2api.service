[Unit]
Description=PaidProxy Gemini Web2API bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gemini-web2api
ExecStart=%h/gemini-web2api/.venv/bin/python %h/gemini-web2api/gemini_web2api.py --config %h/gemini-web2api/config.json
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
